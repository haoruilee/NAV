{
  "name": "rvi-nav-monitor",
  "version": "1.0.0",
  "type": "module",
  "description": "Real-time NAV monitor for Robinhood Ventures Fund I (RVI)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "audit:valuations": "node scripts/nav-valuation-audit.mjs",
    "audit:valuations:local": "node scripts/nav-valuation-audit.mjs --local-only",
    "audit:valuations:dry-run": "node scripts/nav-valuation-audit.mjs --no-apply"
  },
  "dependencies": {
    "express": "^4.21.0"
  }
}
